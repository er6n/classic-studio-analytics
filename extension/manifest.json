{
  "manifest_version": 3,
  "name": "Classic Analytics for YouTube Studio",
  "version": "0.2.0",
  "description": "Brings back the classic Analytics page in YouTube Studio instead of the new Insights hub.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://studio.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://studio.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Classic Analytics",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
